<header class="site-header">
  <div class="container">
    <a href="/" class="brand">
      <svg class="brand-mark" viewBox="0 0 48 48" fill="none" stroke="var(--highlighter)" stroke-width="2.2">
        <circle cx="10" cy="10" r="4.5"/><circle cx="24" cy="10" r="4.5"/><circle cx="38" cy="10" r="4.5" fill="var(--highlighter)" stroke="none"/>
        <circle cx="10" cy="24" r="4.5" fill="var(--highlighter)" stroke="none"/><circle cx="24" cy="24" r="4.5"/><circle cx="38" cy="24" r="4.5"/>
      </svg>
      Test Series
    </a>
    <div class="header-actions">
      <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <a href="/admin/dashboard" class="btn btn-sm">Dashboard</a>
      <% } else { %>
        <a href="/admin/login" class="btn btn-sm">
          <svg width="14" height="14"><use href="#icon-lock"/></svg>
          Admin
        </a>
      <% } %>
    </div>
  </div>
</header>

<%- include('../partials/head') %>
<%- include('../partials/admin-nav') %>

<main class="container admin-main admin-main-narrow">
  <div class="admin-heading">
    <div>
      <h1>Settings</h1>
      <p>Update the admin username or password.</p>
    </div>
  </div>

  <%- include('../partials/flash') %>

  <form method="POST" action="/admin/settings" class="admin-form">
    <div class="field">
      <label for="username">Username</label>
      <input type="text" id="username" name="username" required value="<%= adminUsername %>">
    </div>

    <div class="field">
      <label for="currentPassword">Current password</label>
      <input type="password" id="currentPassword" name="currentPassword" autocomplete="current-password" required>
      <div class="field-hint">Required to confirm any change.</div>
    </div>

    <div class="field-row">
      <div class="field">
        <label for="newPassword">New password</label>
        <input type="password" id="newPassword" name="newPassword" autocomplete="new-password" placeholder="Leave blank to keep current password">
      </div>
      <div class="field">
        <label for="confirmPassword">Confirm new password</label>
        <input type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password">
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save settings</button>
    </div>
  </form>
</main>

<%- include('../partials/footer') %>
